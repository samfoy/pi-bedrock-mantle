{
  "name": "pi-bedrock-mantle",
  "version": "1.0.2",
  "description": "Pi extension: all Bedrock Mantle models (GPT-5.x, Claude, DeepSeek, Qwen3, Mistral, Kimi, ...) via SigV4 — no long-term API key needed",
  "author": "Sam Painter",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "bedrock",
    "bedrock-mantle",
    "gpt-5",
    "openai",
    "aws",
    "sigv4"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samfoy/pi-bedrock-mantle.git"
  },
  "homepage": "https://github.com/samfoy/pi-bedrock-mantle#readme",
  "bugs": {
    "url": "https://github.com/samfoy/pi-bedrock-mantle/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp-test",
    "build": "npm run clean && tsc --noEmit false --outDir dist --rootDir .",
    "check": "tsc --noEmit",
    "test": "rm -rf .tmp-test && tsc --noEmit false --outDir .tmp-test --rootDir . && BEDROCK_MANTLE_LOG_FILE= BEDROCK_MANTLE_EMPTY_DUMP_DIR= node --test test/*.test.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/credential-providers": "^3.799.0",
    "@smithy/signature-v4": "^5.1.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "typescript": "^5.9.3"
  }
}
